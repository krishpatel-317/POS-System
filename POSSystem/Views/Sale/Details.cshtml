@model POSSystem.Models.Sale
@{ 
    ViewData["Title"] = $"Receipt #{Model.SaleId}"; 
    bool isVoided = Model.Status == "Voided";
}

<style>
    /* Thermal Receipt Printable Styles */
    @@media print {
        #sidebar, #topbar, .no-print, nav, .btn-coral, .btn-light-pill, .btn-dark-pill, .btn-danger {
            display: none !important;
        }
        #main-content {
            margin: 0 !important;
            padding: 0 !important;
            background: #ffffff !important;
        }
        body {
            background: #ffffff !important;
            color: #000000 !important;
        }
        .receipt-container {
            box-shadow: none !important;
            border: 1px dashed #000 !important;
            max-width: 420px !important;
            margin: 0 auto !important;
            padding: 24px !important;
        }
        .table-custom tbody tr {
            background: transparent !important;
        }
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-theme receipt-container position-relative">
            @if (isVoided)
            {
                <!-- Watermark for voided sales -->
                <div class="position-absolute top-50 start-50 translate-middle text-danger opacity-25 fw-bold" style="font-size:72px;letter-spacing:6px;pointer-events:none;transform:translate(-50%, -50%) rotate(-25deg);z-index:10;">
                    VOIDED
                </div>
            }

            <div class="card-theme-header flex-wrap gap-2">
                <div>
                    <h5 class="card-theme-title">
                        <i class="fa-solid fa-receipt" style="color:var(--accent-coral);"></i> Store Receipt #@Model.SaleId
                    </h5>
                    <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">
                        Processed on @Model.SaleDate.ToString("dd MMMM yyyy, hh:mm tt")
                    </p>
                </div>
                <div class="d-flex align-items-center gap-2 no-print">
                    <button onclick="window.print()" class="btn-dark-pill">
                        <i class="fa-solid fa-print"></i> Print Receipt
                    </button>
                    @if (isVoided)
                    {
                        <span class="pill-badge pill-coral" style="background:#fef2f2;color:#991b1b;border:1px solid #fecaca;">
                            <i class="fa-solid fa-ban"></i> Voided
                        </span>
                    }
                    else
                    {
                        <span class="pill-badge pill-green">Paid</span>
                    }
                </div>
            </div>

            <!-- Store Brand Header (Useful for prints) -->
            <div class="p-3 rounded-4 mb-4 text-center" style="background:#faf9f6;border:1px dashed var(--border-soft);">
                <div style="font-weight:800;font-size:18px;color:var(--text-title);letter-spacing:-0.4px;">
                    SMART RETAIL POS SYSTEM
                </div>
                <div style="font-size:12px;color:var(--text-subtle);margin-top:2px;">
                    Retail Management &bull; Tax Invoice (GST Compliant)
                </div>
            </div>

            <!-- Summary Row -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="p-3 rounded-4" style="background:#faf9f6;border:1px solid var(--border-soft);">
                        <div style="font-size:11px;color:var(--text-subtle);font-weight:700;text-transform:uppercase;">Customer</div>
                        <div style="font-weight:700;font-size:15px;color:var(--text-title);margin-top:2px;">
                            @(Model.Customer?.Name ?? "Walk-in Customer")
                        </div>
                        <small style="color:var(--text-subtle);font-size:12px;">@(Model.Customer?.Phone ?? "Counter Sale")</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 rounded-4" style="background:#faf9f6;border:1px solid var(--border-soft);">
                        <div style="font-size:11px;color:var(--text-subtle);font-weight:700;text-transform:uppercase;">Cashier</div>
                        <div style="font-weight:700;font-size:15px;color:var(--text-title);margin-top:2px;">
                            @(Model.User?.UserName ?? "Staff")
                        </div>
                        <small style="color:var(--text-subtle);font-size:12px;">Email: @(Model.User?.Email ?? "System")</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 rounded-4" style="background:#faf9f6;border:1px solid var(--border-soft);">
                        <div style="font-size:11px;color:var(--text-subtle);font-weight:700;text-transform:uppercase;">Payment Mode</div>
                        <div style="font-weight:700;font-size:15px;color:var(--accent-coral);margin-top:2px;">
                            @(Model.Payment?.PaymentMethod ?? "Cash")
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Payment?.RazorpayPaymentId))
                        {
                            <small style="color:#166534;font-size:11px;font-weight:700;display:block;word-break:break-all;">
                                <i class="fa-solid fa-circle-check"></i> Ref: @Model.Payment.RazorpayPaymentId
                            </small>
                        }
                        else
                        {
                            <small style="color:var(--text-subtle);font-size:12px;">Status: @Model.Status</small>
                        }
                    </div>
                </div>
            </div>

            <!-- Items Table -->
            <h6 style="font-weight:800;color:var(--text-title);margin-bottom:12px;">Itemized Bill</h6>
            @if (Model.SaleItems == null || !Model.SaleItems.Any())
            {
                <div class="p-3 rounded-4 text-center mb-4" style="background:#faf9f6;border:1px solid var(--border-soft);color:var(--text-subtle);font-size:13px;">
                    This sale was recorded as a direct counter transaction without individual line items.
                </div>
            }
            else
            {
                <div class="table-responsive mb-4">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Product Item</th>
                                <th>Unit Price</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int index = 1; }
                            @foreach (var item in Model.SaleItems)
                            {
                                <tr>
                                    <td><span style="color:var(--text-subtle);font-size:12px;">@(index++)</span></td>
                                    <td>
                                        <div style="font-weight:700;color:var(--text-title);">@item.Product?.Name</div>
                                        @if (item.Product?.Category != null)
                                        {
                                            <span class="pill-badge pill-gray" style="font-size:10px;">
                                                @(item.Product.Category.Name) &bull; @(item.Product.Category.GSTRate.ToString("0.##"))% GST
                                            </span>
                                        }
                                    </td>
                                    <td>&#8377;@item.UnitPrice.ToString("N2")</td>
                                    <td class="text-center"><span class="pill-badge pill-gray">@item.Quantity</span></td>
                                    <td class="text-end" style="font-weight:700;">&#8377;@item.TotalPrice.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Bill Financial Breakdown -->
            <div class="p-3 rounded-4 mb-4" style="background:#faf9f6;border:1px solid var(--border-soft);max-width:320px;margin-left:auto;">
                <div class="d-flex justify-content-between mb-2" style="font-size:13px;">
                    <span style="color:var(--text-subtle);">Items Subtotal:</span>
                    <span style="font-weight:700;">&#8377;@Model.Subtotal.ToString("N2")</span>
                </div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-success" style="font-size:13px;">
                        <span>Discount (@Model.DiscountPercentage%):</span>
                        <span style="font-weight:700;">-&#8377;@Model.DiscountAmount.ToString("N2")</span>
                    </div>
                }
                <div class="d-flex justify-content-between mb-2" style="font-size:13px;">
                    <span style="color:var(--text-subtle);">GST Tax (@Model.TaxPercentage.ToString("0.##")% avg):</span>
                    <span style="font-weight:700;">+&#8377;@Model.TaxAmount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between pt-2 border-top" style="border-color:var(--border-soft) !important;">
                    <span style="font-weight:800;font-size:15px;color:var(--text-title);">FINAL PAID:</span>
                    <span style="font-size:20px;font-weight:800;color:var(--accent-coral);">
                        &#8377;@Model.TotalAmount.ToString("N2")
                    </span>
                </div>
            </div>

            <!-- Footer Action Row -->
            <div class="d-flex justify-content-between align-items-center pt-3 border-top no-print" style="border-color:var(--border-soft) !important;">
                <a asp-action="Index" class="btn-light-pill">
                    <i class="fa-solid fa-arrow-left"></i> Back to Sales
                </a>

                @if (!isVoided && User.IsInRole("Admin"))
                {
                    <!-- Void / Cancel Sale Action -->
                    <form asp-action="Void" asp-route-id="@Model.SaleId" method="post" onsubmit="return confirm('Are you sure you want to void this sale? This will mark the transaction as cancelled and restore the product stock.');" style="margin:0;">
                        <button type="submit" class="btn-light-pill text-danger">
                            <i class="fa-solid fa-ban"></i> Void &amp; Refund Sale
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
