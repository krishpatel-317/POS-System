@model IEnumerable<POSSystem.Models.Sale>
@{ 
    ViewData["Title"] = "Sales History"; 
    string? selectedCashier = ViewBag.SelectedCashier as string;
    string? selectedPayment = ViewBag.SelectedPaymentMethod as string;
    string? selectedDate = ViewBag.SelectedDateRange as string;
    string? search = ViewBag.SearchTerm as string;
    bool showAllStoreSales = ViewBag.ShowAllStoreSales is bool && (bool)ViewBag.ShowAllStoreSales;
    string currentUserId = ViewBag.CurrentPosUserId as string ?? "";
    string currentUserName = ViewBag.CurrentUserName as string ?? "You";
}

<!-- ═══ Sales Performance Metrics ═══ -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card-theme mb-0 p-3 d-flex align-items-center justify-content-between">
            <div>
                <div style="font-size:12px;font-weight:700;color:var(--text-subtle);text-transform:uppercase;letter-spacing:0.5px;">
                    @(showAllStoreSales ? "Store Revenue" : "My Sales Revenue")
                </div>
                <div style="font-size:24px;font-weight:800;color:var(--text-title);margin-top:2px;">
                    &#8377;@(((decimal)(ViewBag.FilteredRevenue ?? 0)).ToString("N2"))
                </div>
            </div>
            <div style="width:48px;height:48px;border-radius:50%;background:var(--accent-soft);color:var(--accent-coral);display:flex;align-items:center;justify-content:center;font-size:18px;">
                <i class="fa-solid fa-indian-rupee-sign"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-theme mb-0 p-3 d-flex align-items-center justify-content-between">
            <div>
                <div style="font-size:12px;font-weight:700;color:var(--text-subtle);text-transform:uppercase;letter-spacing:0.5px;">
                    @(showAllStoreSales ? "Total Orders" : "My Orders")
                </div>
                <div style="font-size:24px;font-weight:800;color:var(--text-title);margin-top:2px;">
                    @(ViewBag.FilteredCount ?? 0) <span style="font-size:14px;font-weight:500;color:var(--text-subtle);">orders</span>
                </div>
            </div>
            <div style="width:48px;height:48px;border-radius:50%;background:var(--pill-gray);color:var(--dark-charcoal);display:flex;align-items:center;justify-content:center;font-size:18px;">
                <i class="fa-solid fa-receipt"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-theme mb-0 p-3 d-flex align-items-center justify-content-between">
            <div>
                <div style="font-size:12px;font-weight:700;color:var(--text-subtle);text-transform:uppercase;letter-spacing:0.5px;">Avg. Ticket Size</div>
                <div style="font-size:24px;font-weight:800;color:var(--text-title);margin-top:2px;">
                    &#8377;@(((decimal)(ViewBag.FilteredAvgTicket ?? 0)).ToString("N2"))
                </div>
            </div>
            <div style="width:48px;height:48px;border-radius:50%;background:#eafaf1;color:#1e824c;display:flex;align-items:center;justify-content:center;font-size:18px;">
                <i class="fa-solid fa-chart-line"></i>
            </div>
        </div>
    </div>
</div>

<div class="card-theme">
    <div class="card-theme-header flex-wrap gap-3">
        <div>
            <h5 class="card-theme-title">
                <i class="fa-solid fa-receipt" style="color:var(--accent-coral);"></i> 
                @(showAllStoreSales ? "All Store Transactions" : $"My Sales ({currentUserName})")
            </h5>
            <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">
                @(showAllStoreSales ? "Viewing all receipts across all staff members." : "Viewing sales recorded by your account.")
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- Export CSV Button (Admin only) -->
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="ExportCsv" 
                   asp-route-cashierId="@selectedCashier" 
                   asp-route-paymentMethod="@selectedPayment" 
                   asp-route-dateRange="@selectedDate" 
                   asp-route-search="@search" 
                   asp-route-showAllStoreSales="@showAllStoreSales" 
                   class="btn-light-pill" 
                   title="Export current filtered sales to CSV spreadsheet">
                    <i class="fa-solid fa-file-csv text-success"></i> Export CSV
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                if (showAllStoreSales)
                {
                    <a asp-action="Index" class="btn-dark-pill">
                        <i class="fa-solid fa-user"></i> Switch to My Sales
                    </a>
                }
                else
                {
                    <a asp-action="Index" asp-route-showAllStoreSales="true" class="btn-light-pill">
                        <i class="fa-solid fa-users"></i> View All Store Sales
                    </a>
                }
            }
            <a asp-action="Create" class="btn-coral">
                <i class="fa-solid fa-cart-plus"></i> New Sale
            </a>
        </div>
    </div>

    <!-- ═══ Filter Toolbar ═══ -->
    <form method="get" asp-action="Index" class="mb-4">
        <input type="hidden" name="showAllStoreSales" value="@(showAllStoreSales ? "true" : "false")" />
        <div class="row g-2 align-items-center">
            <div class="@(User.IsInRole("Admin") ? "col-lg-3 col-md-4" : "col-lg-4 col-md-5")">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border-radius:14px 0 0 14px; border-color:var(--border-soft);">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Search Customer, Sale #..." style="border-radius:0 14px 14px 0;" />
                </div>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="col-lg-2 col-md-3">
                    <select name="cashierId" asp-items="ViewBag.Cashiers" class="form-select">
                        <option value="">@(showAllStoreSales ? "All Cashiers" : "My Account Only")</option>
                    </select>
                </div>
            }

            <div class="col-lg-2 col-md-3">
                <select name="paymentMethod" asp-items="ViewBag.PaymentMethods" class="form-select">
                    <option value="">All Payments</option>
                </select>
            </div>

            <div class="col-lg-3 col-md-4">
                <select name="dateRange" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(selectedDate))">All Dates</option>
                    <option value="today" selected="@(selectedDate == "today")">Today</option>
                    <option value="week" selected="@(selectedDate == "week")">This Week</option>
                    <option value="month" selected="@(selectedDate == "month")">This Month</option>
                </select>
            </div>

            <div class="col-lg-2 col-md-2 d-flex gap-2">
                <button type="submit" class="btn-dark-pill w-100 justify-content-center" style="padding:10px 14px;">
                    <i class="fa-solid fa-filter"></i> Apply
                </button>
                @if (!string.IsNullOrEmpty(selectedCashier) || !string.IsNullOrEmpty(selectedPayment) || !string.IsNullOrEmpty(selectedDate) || !string.IsNullOrEmpty(search) || showAllStoreSales)
                {
                    <a asp-action="Index" class="btn-light-pill justify-content-center" title="Reset to My Sales" style="padding:10px 14px;">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                }
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="width:54px;height:54px;background:var(--pill-gray);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:var(--text-subtle);">
                <i class="fa-solid fa-receipt fa-lg"></i>
            </div>
            <div style="font-weight:700;font-size:15px;color:var(--text-title);">No sales recorded under this account yet</div>
            <p style="font-size:13px;color:var(--text-subtle);margin-top:4px;">
                @(showAllStoreSales ? "No transactions found in the database." : "You haven't processed any sales yet. Click 'New Sale' to record an order under your account!")
            </p>
            <div class="d-flex justify-content-center gap-2 mt-3">
                <a asp-action="Create" class="btn-coral">
                    <i class="fa-solid fa-cart-plus"></i> Record Your First Sale
                </a>
                @if (User.IsInRole("Admin") && !showAllStoreSales)
                {
                    <a asp-action="Index" asp-route-showAllStoreSales="true" class="btn-light-pill">
                        <i class="fa-solid fa-users"></i> View Other Staff Sales
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Sale #</th>
                        <th>Date &amp; Time</th>
                        <th>Customer</th>
                        <th>Cashier</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="pill-badge pill-gray">#@item.SaleId</span>
                            </td>
                            <td><span style="color:var(--text-subtle);font-size:13px;">@item.SaleDate.ToString("dd MMM yyyy, hh:mm tt")</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:28px;height:28px;border-radius:50%;background:var(--pill-gray);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--text-title);">
                                        @(item.Customer != null ? item.Customer.Name.Substring(0, 1).ToUpper() : "W")
                                    </div>
                                    <span>@(item.Customer?.Name ?? "Walk-in Customer")</span>
                                </div>
                            </td>
                            <td>
                                <span class="pill-badge @(item.UserId == currentUserId ? "pill-coral" : "pill-gray")">
                                    <i class="fa-solid fa-user-tag"></i>
                                    @(item.User?.UserName ?? "Staff") @(item.UserId == currentUserId ? "(You)" : "")
                                </span>
                            </td>
                            <td>
                                @if (item.Payment?.PaymentMethod == "UPI")
                                {
                                    <span class="pill-badge pill-green">
                                        <i class="fa-solid fa-qrcode"></i> UPI
                                    </span>
                                }
                                else if (item.Payment?.PaymentMethod == "Card")
                                {
                                    <span class="pill-badge pill-dark">
                                        <i class="fa-regular fa-credit-card"></i> Card
                                    </span>
                                }
                                else
                                {
                                    <span class="pill-badge pill-coral">
                                        <i class="fa-solid fa-money-bill-wave"></i> Cash
                                    </span>
                                }
                            </td>
                            <td>
                                @if (item.Status == "Voided")
                                {
                                    <span class="pill-badge pill-coral" style="background:#fef2f2;color:#991b1b;border:1px solid #fecaca;font-size:11px;">
                                        <i class="fa-solid fa-ban"></i> Voided
                                    </span>
                                }
                                else
                                {
                                    <span class="pill-badge pill-green" style="font-size:11px;">
                                        <i class="fa-solid fa-check"></i> Paid
                                    </span>
                                }
                            </td>
                            <td>
                                <span style="font-weight:800;font-size:15px;@(item.Status == "Voided" ? "text-decoration:line-through;color:var(--text-subtle);" : "color:var(--text-title);")">
                                    &#8377;@item.TotalAmount.ToString("N2")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.SaleId" class="btn-light-pill">
                                    <i class="fa-solid fa-print"></i> Receipt
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
