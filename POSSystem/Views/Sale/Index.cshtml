@model IEnumerable<POSSystem.Models.Sale>
@{ 
    ViewData["Title"] = "Sales History"; 
}

<div class="card-theme">
    <div class="card-theme-header">
        <div>
            <h5 class="card-theme-title">
                <i class="fa-solid fa-receipt" style="color:var(--accent-coral);"></i> Sales History
            </h5>
            <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">
                All logged customer transactions and revenue records.
            </p>
        </div>
        <a asp-action="Create" class="btn-coral">
            <i class="fa-solid fa-plus"></i> New Sale
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="width:54px;height:54px;background:var(--pill-gray);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:var(--text-subtle);">
                <i class="fa-solid fa-receipt fa-lg"></i>
            </div>
            <div style="font-weight:700;font-size:14px;color:var(--text-title);">No sales recorded yet</div>
            <p style="font-size:13px;color:var(--text-subtle);margin-top:2px;">Click "New Sale" to record your first transaction.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Sale #</th>
                        <th>Date &amp; Time</th>
                        <th>Customer</th>
                        <th>Cashier</th>
                        <th>Payment Method</th>
                        <th>Amount</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="pill-badge pill-gray">#@item.SaleId</span>
                            </td>
                            <td><span style="color:var(--text-subtle);font-size:13px;">@item.SaleDate.ToString("dd MMM yyyy, hh:mm tt")</span></td>
                            <td>@(item.Customer?.Name ?? "Walk-in Customer")</td>
                            <td><span style="color:var(--text-subtle);font-size:13px;">@(item.User?.Name ?? "Staff")</span></td>
                            <td>
                                <span class="pill-badge pill-coral">
                                    <i class="fa-regular fa-credit-card"></i>
                                    @(item.Payment?.PaymentMethod ?? "Cash")
                                </span>
                            </td>
                            <td>
                                <span style="font-weight:800;color:var(--text-title);">&#8377;@item.TotalAmount.ToString("N2")</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.SaleId" class="btn-light-pill">
                                    <i class="fa-solid fa-eye"></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
