@{ 
    ViewData["Title"] = "New Sale";
    var availableProducts = ViewBag.AvailableProducts as IEnumerable<POSSystem.Models.Product> ?? Enumerable.Empty<POSSystem.Models.Product>();
}

<div class="row g-4">
    <!-- Left Column: Product Selection, Barcode Scanner & Cart Items -->
    <div class="col-lg-8">
        <div class="card-theme">
            <div class="card-theme-header">
                <div>
                    <h5 class="card-theme-title">
                        <i class="fa-solid fa-cart-plus" style="color:var(--accent-coral);"></i> Billing Counter Cart
                    </h5>
                    <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">Scan barcodes or select products to build customer bill</p>
                </div>
                <span class="pill-badge pill-coral">Interactive Checkout</span>
            </div>

            <!-- Barcode / SKU Quick Scanner Input -->
            <div class="p-3 rounded-4 mb-3" style="background:#faf9f6;border:1px solid var(--border-soft);">
                <label class="form-label mb-1 d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-barcode text-muted me-1"></i> Barcode / SKU Instant Scanner</span>
                    <span class="badge bg-secondary text-white" style="font-size:10px;font-weight:600;">Hardware Scanner Ready</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border-radius:14px 0 0 14px;border-color:var(--border-soft);">
                        <i class="fa-solid fa-qrcode text-muted"></i>
                    </span>
                    <input type="text" id="barcodeScanner" class="form-control border-start-0 border-end-0" placeholder="Scan barcode or type SKU / Name..." autofocus />
                    <button type="button" id="btnScanCode" class="btn-coral" style="border-radius:0 14px 14px 0;padding:0 20px;">
                        <i class="fa-solid fa-plus me-1"></i> Add
                    </button>
                </div>
                <div id="scanFeedback" style="font-size:11px;color:var(--text-subtle);margin-top:4px;">
                    Tip: Click Add or press Enter. USB barcode scanners automatically submit.
                </div>
            </div>

            <!-- Manual Product Selection Bar -->
            <div class="p-3 rounded-4 mb-4" style="background:#faf9f6;border:1px solid var(--border-soft);">
                <div class="row g-2 align-items-end">
                    <div class="col-md-7">
                        <label class="form-label mb-1">Or Select from Catalog</label>
                        <select id="productSelect" class="form-select">
                            <option value="">-- Choose Product --</option>
                            @foreach (var p in availableProducts)
                            {
                                <option value="@p.ProductId" data-name="@p.Name" data-price="@p.Price" data-stock="@p.StockQuantity" data-sku="@p.SKU" data-gst="@(p.Category?.GSTRate ?? 18)" data-category="@(p.Category?.Name ?? "General")">
                                    @p.Name @(!string.IsNullOrEmpty(p.SKU) ? $"[{p.SKU}]" : "") — &#8377;@p.Price.ToString("N2") (@(p.Category?.GSTRate ?? 18)% GST, @p.StockQuantity in stock)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label mb-1">Qty</label>
                        <input id="productQty" type="number" min="1" value="1" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="btnAddItem" class="btn-coral w-100 justify-content-center">
                            <i class="fa-solid fa-plus"></i> Add
                        </button>
                    </div>
                </div>
            </div>

            <!-- Cart Items Table -->
            <div class="table-responsive mb-3">
                <table class="table-custom" id="cartTable">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Unit Price</th>
                            <th style="width:140px;">Quantity</th>
                            <th>Subtotal</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody id="cartTableBody">
                        <tr id="emptyCartRow">
                            <td colspan="5" class="text-center py-4">
                                <div style="font-size:13px;color:var(--text-subtle);">
                                    <i class="fa-solid fa-cart-shopping me-1"></i> Cart is empty. Scan a barcode or select a product above.
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Total Bar -->
            <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color:var(--border-soft) !important;">
                <span style="font-size:14px;font-weight:700;color:var(--text-subtle);">Cart Subtotal:</span>
                <span style="font-size:24px;font-weight:800;color:var(--accent-coral);" id="cartSubtotalDisplay">&#8377;0.00</span>
            </div>
        </div>
    </div>

    <!-- Right Column: Customer, Discount, GST & Checkout -->
    <div class="col-lg-4">
        <div class="card-theme">
            <h5 class="card-theme-title mb-3">
                <i class="fa-solid fa-receipt" style="color:var(--accent-coral);"></i> Transaction Details
            </h5>

            <form asp-action="Create" method="post" id="checkoutForm">
                <!-- Hidden Container for Array Form Fields -->
                <div id="hiddenFieldsContainer"></div>

                <!-- Cashier Attribution -->
                <div class="mb-3">
                    <label class="form-label">Cashier Counter</label>
                    <div class="p-2 px-3 rounded-3" style="background:#faf9f6;border:1px solid var(--border-soft);font-weight:700;color:var(--text-title);display:flex;align-items:center;gap:8px;">
                        <i class="fa-solid fa-user-check" style="color:var(--accent-coral);"></i>
                        <span>@ViewBag.CurrentCashierName</span>
                        <span class="pill-badge pill-coral ms-auto" style="font-size:11px;">Active Cashier</span>
                    </div>
                </div>

                <!-- Customer Selection with Quick Add -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label mb-0">Customer (Optional)</label>
                        <button type="button" class="btn btn-sm btn-light-pill text-primary px-2 py-0" data-bs-toggle="modal" data-bs-target="#quickCustomerModal" style="font-size:11px;font-weight:700;">
                            <i class="fa-solid fa-user-plus me-1"></i> + Quick Add
                        </button>
                    </div>
                    <select name="customerId" id="customerSelect" class="form-select" asp-items="ViewBag.Customers">
                        <option value="0">-- Walk-in Customer --</option>
                    </select>
                </div>

                <!-- Payment Method -->
                <div class="mb-3">
                    <label class="form-label">Payment Method <span class="text-danger">*</span></label>
                    <select name="paymentMethod" id="paymentMethodSelect" class="form-select" asp-items="ViewBag.PaymentMethods" required>
                    </select>
                    <small id="razorpayHint" class="text-success mt-1" style="font-size:11px;display:none;font-weight:600;">
                        <i class="fa-solid fa-qrcode"></i> Powered by Razorpay: Live UPI QR, Cards &amp; Netbanking popup.
                    </small>
                </div>

                <!-- Hidden Razorpay Transaction Attributes -->
                <input type="hidden" name="razorpayOrderId" id="razorpayOrderId" value="" />
                <input type="hidden" name="razorpayPaymentId" id="razorpayPaymentId" value="" />
                <input type="hidden" name="razorpaySignature" id="razorpaySignature" value="" />

                <!-- Discount Selector -->
                <div class="mb-3">
                    <label class="form-label">Discount Offer</label>
                    <select id="discountSelect" name="discountPercentage" class="form-select">
                        <option value="0">No Discount (0%)</option>
                        <option value="5">Festive Offer (5% Off)</option>
                        <option value="10">Loyalty Special (10% Off)</option>
                        <option value="15">Super Saver (15% Off)</option>
                        <option value="20">Clearance Deal (20% Off)</option>
                    </select>
                </div>

                <!-- Category-based Tax (GST) Notice -->
                <div class="mb-3">
                    <label class="form-label">Tax Calculation (GST)</label>
                    <div class="p-2 px-3 rounded-3" style="background:#faf9f6;border:1px solid var(--border-soft);font-size:13px;display:flex;align-items:center;justify-content:space-between;">
                        <span><i class="fa-solid fa-calculator text-muted me-1"></i> Category GST</span>
                        <span class="pill-badge pill-green" id="effectiveTaxBadge">Auto-calculated</span>
                    </div>
                    <small style="font-size:11px;color:var(--text-subtle);display:block;margin-top:4px;">
                        Each product is taxed according to its category rate (configured under Categories).
                    </small>
                </div>

                <!-- Live Itemized Bill Summary -->
                <div class="p-3 rounded-4 mb-4" style="background:#faf9f6;border:1px solid var(--border-soft);font-size:13px;">
                    <div class="d-flex justify-content-between mb-1">
                        <span style="color:var(--text-subtle);">Items Subtotal:</span>
                        <span id="summarySubtotal" style="font-weight:700;">&#8377;0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1" id="discountRow" style="color:#166534;display:none;">
                        <span>Discount (<span id="discountPctLabel">0</span>%):</span>
                        <span id="summaryDiscount" style="font-weight:700;">-&#8377;0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span style="color:var(--text-subtle);">GST Tax (Category-based):</span>
                        <span id="summaryTax" style="font-weight:700;">+&#8377;0.00</span>
                    </div>
                    <div class="d-flex justify-content-between pt-2 border-top" style="border-color:var(--border-soft) !important;">
                        <span style="font-weight:800;font-size:15px;color:var(--text-title);">Final Payable:</span>
                        <span id="summaryPayable" style="font-size:20px;font-weight:800;color:var(--accent-coral);">&#8377;0.00</span>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-coral w-100 justify-content-center py-3" style="font-size:15px;" id="btnCheckout">
                    <i class="fa-solid fa-check me-1"></i> Complete &amp; Save Sale
                </button>
                <a asp-action="Index" class="btn-light-pill w-100 justify-content-center mt-2">Cancel</a>
            </form>
        </div>
    </div>
</div>

<!-- Quick Customer Registration Modal -->
<div class="modal fade" id="quickCustomerModal" tabindex="-1" aria-labelledby="quickCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:24px;border:none;box-shadow:var(--shadow-card);padding:10px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="quickCustomerModalLabel" style="font-weight:800;color:var(--text-title);">
                    <i class="fa-solid fa-user-plus text-primary me-2"></i> Quick Add Customer
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="quickCustomerAlert" class="alert alert-danger py-2" style="font-size:12px;display:none;"></div>
                <div class="mb-3">
                    <label class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input type="text" id="quickCustName" class="form-control" placeholder="e.g. Rahul Sharma" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Phone Number <span class="text-danger">*</span></label>
                    <input type="text" id="quickCustPhone" class="form-control" placeholder="e.g. +91 98765 43210" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Email Address (Optional)</label>
                    <input type="email" id="quickCustEmail" class="form-control" placeholder="e.g. rahul@example.com" />
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn-light-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSaveQuickCustomer" class="btn-coral">
                    <i class="fa-solid fa-check me-1"></i> Register &amp; Select
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Quick Add Customer AJAX Handler
    $('#btnSaveQuickCustomer').click(function () {
        const name = $('#quickCustName').val().trim();
        const phone = $('#quickCustPhone').val().trim();
        const email = $('#quickCustEmail').val().trim();
        const alertBox = $('#quickCustomerAlert');

        alertBox.hide();

        if (!name) {
            alertBox.text('Please enter customer full name.').show();
            return;
        }
        if (!phone) {
            alertBox.text('Please enter customer phone number.').show();
            return;
        }

        const btn = $(this);
        btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> Saving...');

        $.ajax({
            url: '/Customer/QuickCreate',
            type: 'POST',
            data: { name: name, phone: phone, email: email },
            success: function (res) {
                btn.prop('disabled', false).html('<i class="fa-solid fa-check me-1"></i> Register &amp; Select');
                if (res.success) {
                    // Add new option to dropdown and select it
                    const newOption = new Option(res.displayName, res.customerId, true, true);
                    $('#customerSelect').append(newOption).trigger('change');

                    // Reset form and close modal
                    $('#quickCustName').val('');
                    $('#quickCustPhone').val('');
                    $('#quickCustEmail').val('');
                    const modalEl = document.getElementById('quickCustomerModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                } else {
                    alertBox.text(res.message || 'Failed to add customer.').show();
                }
            },
            error: function () {
                btn.prop('disabled', false).html('<i class="fa-solid fa-check me-1"></i> Register &amp; Select');
                alertBox.text('Server error occurred while registering customer.').show();
            }
        });
    });
    // In-memory catalog for instant barcode/SKU lookup with category & GST rate
    const catalog = [
        @foreach (var p in availableProducts)
        {
            <text>{ id: @p.ProductId, name: "@Html.Raw(p.Name.Replace("\"", "\\\""))", price: @p.Price, stock: @p.StockQuantity, sku: "@Html.Raw((p.SKU ?? "").Replace("\"", "\\\""))", gst: @(p.Category?.GSTRate ?? 18), category: "@Html.Raw((p.Category?.Name ?? "General").Replace("\"", "\\\""))" },</text>
        }
    ];

    let cart = [];

    // Helper: Add product to cart by ID & quantity
    function addToCart(pId, qty) {
        const product = catalog.find(p => p.id === pId);
        if (!product) return;

        if (qty > product.stock) {
            alert('Cannot add more than available stock (' + product.stock + ').');
            return;
        }

        const existing = cart.find(item => item.id === pId);
        if (existing) {
            if (existing.qty + qty > product.stock) {
                alert('Cannot exceed available stock (' + product.stock + ').');
                return;
            }
            existing.qty += qty;
        } else {
            cart.push({ 
                id: product.id, 
                name: product.name, 
                price: product.price, 
                qty: qty, 
                stock: product.stock,
                gst: product.gst,
                category: product.category
            });
        }

        updateCartUI();
    }

    // 1. Barcode / SKU Scanner Handler (Triggered on Enter key or clicking Add button)
    function handleScanLookup() {
        const input = $('#barcodeScanner');
        const term = input.val().trim().toLowerCase();
        if (!term) return;

        // Search by SKU exact, Product ID exact, or Name contains
        const matched = catalog.find(p => 
            (p.sku && p.sku.toLowerCase() === term) ||
            p.id.toString() === term ||
            p.name.toLowerCase() === term ||
            p.name.toLowerCase().includes(term)
        );

        if (matched) {
            addToCart(matched.id, 1);
            input.val('').focus();
            $('#scanFeedback').html(`<span class="text-success"><i class="fa-solid fa-check"></i> Added: <strong>${matched.name}</strong></span>`);
        } else {
            $('#scanFeedback').html(`<span class="text-danger"><i class="fa-solid fa-circle-exclamation"></i> No stock found matching "${term}"</span>`);
        }
    }

    $('#barcodeScanner').on('keydown', function (e) {
        if (e.which === 13) { // Enter key
            e.preventDefault();
            handleScanLookup();
        }
    });

    $('#btnScanCode').click(function () {
        handleScanLookup();
    });

    // 2. Manual Product Selection Button
    $('#btnAddItem').click(function () {
        const select = $('#productSelect option:selected');
        const pId = parseInt(select.val());
        if (!pId) {
            alert('Please select a valid product.');
            return;
        }
        const qty = parseInt($('#productQty').val()) || 1;
        addToCart(pId, qty);
    });

    // 3. Adjust Quantity (+ or -)
    function changeQty(pId, delta) {
        const item = cart.find(i => i.id === pId);
        if (item) {
            item.qty += delta;
            if (item.qty <= 0) {
                removeItem(pId);
            } else if (item.qty > item.stock) {
                alert('Maximum available stock is ' + item.stock);
                item.qty = item.stock;
                updateCartUI();
            } else {
                updateCartUI();
            }
        }
    }

    // 4. Remove Item Completely
    function removeItem(pId) {
        cart = cart.filter(i => i.id !== pId);
        updateCartUI();
    }

    // 5. Update Cart Table, Subtotal, Discount, Category GST, Grand Total
    function updateCartUI() {
        const tbody = $('#cartTableBody');
        tbody.empty();

        if (cart.length === 0) {
            tbody.html(`
                <tr id="emptyCartRow">
                    <td colspan="5" class="text-center py-4">
                        <div style="font-size:13px;color:var(--text-subtle);">
                            <i class="fa-solid fa-cart-shopping me-1"></i> Cart is empty. Scan a barcode or select a product above.
                        </div>
                    </td>
                </tr>
            `);
            $('#cartSubtotalDisplay').text('₹0.00');
            $('#summarySubtotal').text('₹0.00');
            $('#summaryDiscount').text('-₹0.00');
            $('#summaryTax').text('+₹0.00');
            $('#summaryPayable').text('₹0.00');
            $('#effectiveTaxBadge').text('Auto-calculated');
            $('#discountRow').hide();
            return;
        }

        const discountPct = parseFloat($('#discountSelect').val()) || 0;
        const discountFactor = Math.max(0, 1 - (discountPct / 100));

        let subtotal = 0;
        let totalTax = 0;

        cart.forEach(item => {
            const lineTotal = item.qty * item.price;
            subtotal += lineTotal;

            // Proportional tax after discount
            const discountedLineTotal = lineTotal * discountFactor;
            const lineTax = discountedLineTotal * (item.gst / 100);
            totalTax += lineTax;

            const row = `
                <tr>
                    <td>
                        <div style="font-weight:700;color:var(--text-title);">${item.name}</div>
                        <span class="pill-badge pill-gray" style="font-size:11px;">${item.category} &bull; ${item.gst}% GST</span>
                    </td>
                    <td>&#8377;${item.price.toFixed(2)}</td>
                    <td>
                        <div class="d-flex align-items-center gap-1">
                            <button type="button" class="btn btn-sm btn-light-pill px-2 py-0" onclick="changeQty(${item.id}, -1)">-</button>
                            <span class="pill-badge pill-dark px-3">${item.qty}</span>
                            <button type="button" class="btn btn-sm btn-light-pill px-2 py-0" onclick="changeQty(${item.id}, 1)">+</button>
                        </div>
                    </td>
                    <td><span style="font-weight:700;">&#8377;${lineTotal.toFixed(2)}</span></td>
                    <td class="text-end">
                        <button type="button" class="btn-light-pill text-danger px-2 py-1" onclick="removeItem(${item.id})">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `;
            tbody.append(row);
        });

        // Compute Discount & Payable totals
        const discountAmt = subtotal * (discountPct / 100);
        const discountedSubtotal = Math.max(0, subtotal - discountAmt);
        const grandTotal = discountedSubtotal + totalTax;
        const effectiveTaxPct = discountedSubtotal > 0 ? ((totalTax / discountedSubtotal) * 100).toFixed(1) : 0;

        $('#cartSubtotalDisplay').text('₹' + subtotal.toFixed(2));
        $('#summarySubtotal').text('₹' + subtotal.toFixed(2));

        if (discountPct > 0) {
            $('#discountPctLabel').text(discountPct);
            $('#summaryDiscount').text('-₹' + discountAmt.toFixed(2));
            $('#discountRow').show();
        } else {
            $('#discountRow').hide();
        }

        $('#effectiveTaxBadge').text('~' + effectiveTaxPct + '% Effective GST');
        $('#summaryTax').text('+₹' + totalTax.toFixed(2));
        $('#summaryPayable').text('₹' + grandTotal.toFixed(2));
    }

    // Listener for discount offer change
    $('#discountSelect').change(function () {
        updateCartUI();
    });

    // Payment method hint & UI update
    function checkPaymentMethod() {
        const method = $('#paymentMethodSelect').val();
        if (method === 'UPI' || method === 'Card') {
            $('#razorpayHint').show();
            $('#btnCheckout').html('<i class="fa-solid fa-qrcode me-1"></i> Pay with Razorpay &amp; Save');
        } else {
            $('#razorpayHint').hide();
            $('#btnCheckout').html('<i class="fa-solid fa-check me-1"></i> Complete &amp; Save Sale');
        }
    }
    $('#paymentMethodSelect').change(checkPaymentMethod);
    checkPaymentMethod();

    // 6. Form Submission: serialize cart arrays into hidden inputs & launch Razorpay if UPI/Card
    let isRazorpayVerified = false;

    $('#checkoutForm').submit(function (e) {
        if (cart.length === 0) {
            e.preventDefault();
            alert('Please add at least one product to the cart before checking out.');
            return false;
        }

        const container = $('#hiddenFieldsContainer');
        container.empty();

        cart.forEach(item => {
            container.append(`<input type="hidden" name="productIds" value="${item.id}" />`);
            container.append(`<input type="hidden" name="quantities" value="${item.qty}" />`);
            container.append(`<input type="hidden" name="unitPrices" value="${item.price}" />`);
        });

        const selectedPayment = $('#paymentMethodSelect').val();

        // If Cash or already verified by Razorpay modal, submit form directly
        if (selectedPayment === 'Cash' || isRazorpayVerified) {
            return true;
        }

        // If UPI or Card, launch official Razorpay Checkout Modal
        e.preventDefault();

        const payableText = $('#summaryPayable').text().replace('₹', '').replace(',', '');
        const payableAmount = parseFloat(payableText);

        if (isNaN(payableAmount) || payableAmount <= 0) {
            alert('Invalid order payable amount.');
            return false;
        }

        const btn = $('#btnCheckout');
        const originalText = btn.html();
        btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Launching Razorpay...');

        // Step A: Request server to create Razorpay Order
        $.ajax({
            url: '/Sale/CreateRazorpayOrder',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ amount: payableAmount }),
            success: function (res) {
                btn.prop('disabled', false).html(originalText);

                if (!res.success) {
                    alert(res.message || 'Failed to initiate Razorpay order.');
                    return;
                }

                // Step B: Configure Razorpay Checkout Modal
                const options = {
                    "key": res.keyId,
                    "amount": res.amount,
                    "currency": "INR",
                    "name": "Smart Retail POS",
                    "description": "Counter Sale Invoice",
                    "image": "/images/logo.png?v=3",
                    "order_id": res.orderId,
                    "handler": function (response) {
                        // Step C: Payment Succeeded! Attach tokens and submit form
                        $('#razorpayOrderId').val(response.razorpay_order_id);
                        $('#razorpayPaymentId').val(response.razorpay_payment_id);
                        $('#razorpaySignature').val(response.razorpay_signature);

                        isRazorpayVerified = true;
                        $('#checkoutForm').submit();
                    },
                    "prefill": {
                        "name": $('#customerSelect option:selected').text().split('(')[0].trim() || "Retail Customer",
                        "contact": ""
                    },
                    "theme": {
                        "color": "#eb573d"
                    },
                    "modal": {
                        "ondismiss": function() {
                            btn.prop('disabled', false).html(originalText);
                        }
                    }
                };

                const rzp = new Razorpay(options);
                rzp.on('payment.failed', function (response) {
                    alert('Payment Failed: ' + response.error.description);
                    btn.prop('disabled', false).html(originalText);
                });
                rzp.open();
            },
            error: function () {
                btn.prop('disabled', false).html(originalText);
                alert('Server error occurred while creating Razorpay order.');
            }
        });

        return false;
    });
</script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
}
