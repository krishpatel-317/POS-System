@model IEnumerable<POSSystem.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="card-theme">
    <div class="card-theme-header">
        <div>
            <h5 class="card-theme-title">
                <i class="fa-solid fa-tags" style="color:var(--accent-coral);"></i> Product Categories
            </h5>
            <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">
                Group items into aisles or departments for structured inventory.
            </p>
        </div>
        <a asp-action="Create" class="btn-coral">
            <i class="fa-solid fa-plus"></i> Add Category
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="width:54px;height:54px;background:var(--pill-gray);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:var(--text-subtle);">
                <i class="fa-solid fa-tags fa-lg"></i>
            </div>
            <div style="font-weight:700;font-size:14px;color:var(--text-title);">No categories found</div>
            <p style="font-size:13px;color:var(--text-subtle);margin-top:2px;">Click "Add Category" to create your first department.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Category Name</th>
                        <th>Assigned Products</th>
                        <th>GST Rate</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><span class="pill-badge pill-gray">@i</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;border-radius:10px;background:var(--accent-soft);display:flex;align-items:center;justify-content:center;color:var(--accent-coral);font-size:13px;">
                                        <i class="fa-solid fa-tag"></i>
                                    </div>
                                    <span style="font-weight:700;color:var(--text-title);">@c.Name</span>
                                </div>
                            </td>
                            <td>
                                <span class="pill-badge pill-gray">
                                    @(c.Products?.Count ?? 0) Products
                                </span>
                            </td>
                            <td>
                                <span class="pill-badge pill-green">
                                    <i class="fa-solid fa-percent" style="font-size:10px;"></i> @c.GSTRate.ToString("0.##")% GST
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn-light-pill me-1">
                                    <i class="fa-solid fa-pen-to-square"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@c.CategoryId" class="btn-light-pill text-danger">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>
