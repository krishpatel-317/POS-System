@model POSSystem.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">
        <div class="card-theme">
            <div class="text-center mb-4">
                <div style="width:58px;height:58px;background:var(--accent-soft);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;color:var(--accent-coral);">
                    <i class="fa-solid fa-trash fa-lg"></i>
                </div>
                <h5 style="font-weight:800;color:var(--text-title);margin:0;">Delete Product?</h5>
                <p style="font-size:13px;color:var(--text-subtle);margin-top:4px;">
                    Are you sure you want to remove <strong>"@Model.Name"</strong>?
                </p>
            </div>

            <div class="p-3 rounded-4 mb-4" style="background:#faf9f6;border:1px solid var(--border-soft);">
                <div class="d-flex justify-content-between mb-2">
                    <span style="font-size:13px;color:var(--text-subtle);">Category</span>
                    <span class="pill-badge pill-gray">@(Model.Category?.Name ?? "General")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span style="font-size:13px;color:var(--text-subtle);">Price</span>
                    <span style="font-weight:700;">&#8377;@Model.Price.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span style="font-size:13px;color:var(--text-subtle);">Current Stock</span>
                    <span class="pill-badge pill-dark">@Model.StockQuantity units</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span style="font-size:13px;color:var(--text-subtle);">Past Sales</span>
                    <span class="pill-badge pill-gray">@(Model.SaleItems?.Count ?? 0) receipts</span>
                </div>
            </div>

            @if ((Model.SaleItems?.Count ?? 0) > 0)
            {
                <div class="p-3 rounded-4 mb-4" style="background:#eff6ff;border:1px solid #bfdbfe;font-size:12px;color:#1e40af;">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    <strong>Smart Archive:</strong> This product was sold in @(Model.SaleItems?.Count ?? 0) transaction(s). Deleting it will immediately remove it from your catalog and checkout counter while safely preserving your historical receipts.
                </div>
            }

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="ProductId" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn-coral flex-grow-1 justify-content-center">
                        <i class="fa-solid fa-trash"></i> Yes, Delete
                    </button>
                    <a asp-action="Index" class="btn-light-pill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
