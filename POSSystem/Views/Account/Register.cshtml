@model POSSystem.Models.RegisterViewModel
@{
    Layout = null; // Full-page register screen, no sidebar
    ViewData["Title"] = "Register";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register – Smart Retail POS System</title>

    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon.png?v=3" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon.png?v=3" />
    <link rel="shortcut icon" href="~/favicon.ico?v=3" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --accent-coral: #eb573d;
            --accent-hover: #d8472d;
            --bg-page: #f4f3ef;
            --border-soft: #eae7e0;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: var(--bg-page);
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
        }
        .register-card {
            background: #fff;
            border-radius: 28px;
            border: 1px solid var(--border-soft);
            padding: 44px 40px;
            width: 100%;
            max-width: 460px;
            box-shadow: 0 8px 48px rgba(0,0,0,0.07);
        }
        h1 { font-size: 26px; font-weight: 800; color: #141416; margin-bottom: 6px; }
        .subtitle { font-size: 14px; color: #82828a; font-weight: 500; margin-bottom: 28px; }
        .form-label { font-size: 13px; font-weight: 700; color: #141416; margin-bottom: 6px; }
        .form-control, .form-select {
            border-radius: 14px;
            border: 1px solid var(--border-soft);
            padding: 11px 16px;
            font-size: 14px;
            font-family: inherit;
            background: #faf9f6;
        }
        .form-control:focus, .form-select:focus {
            background: #fff;
            border-color: var(--accent-coral);
            box-shadow: 0 0 0 3px rgba(235,87,61,0.12);
        }
        .btn-register {
            width: 100%;
            background: var(--accent-coral);
            color: #fff;
            border: none;
            border-radius: 14px;
            padding: 13px;
            font-size: 15px;
            font-weight: 700;
            font-family: inherit;
            margin-top: 10px;
            cursor: pointer;
            transition: background 0.18s;
        }
        .btn-register:hover { background: var(--accent-hover); }
        .login-link {
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            color: #82828a;
        }
        .login-link a { color: var(--accent-coral); font-weight: 700; text-decoration: none; }
        .text-danger { font-size: 12px; font-weight: 600; }
        .alert-error {
            background: #fef2f2; color: #991b1b;
            border: 1px solid #fecaca;
            border-radius: 12px; padding: 12px 16px;
            font-size: 13px; font-weight: 600;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="mb-3">
            <img src="~/images/logo.png?v=3" width="60" height="60" alt="Smart Retail POS" style="object-fit:contain;" />
        </div>
        <h1>Create Account</h1>
        <p class="subtitle">Set up user access for Smart Retail POS System</p>

        @if (!ViewData.ModelState.IsValid)
        {
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div class="alert-error">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>@error.ErrorMessage
                </div>
            }
        }

        <form asp-action="Register" method="post">
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Full Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Ramesh Patel" autofocus />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label">Username</label>
                    <input asp-for="Username" class="form-control" placeholder="e.g. ramesh12" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Role" class="form-label">Assign Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Cashier">Cashier (Staff)</option>
                        <option value="Manager">Store Manager</option>
                        <option value="Admin">Store Owner (Admin)</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="ramesh@posstore.local" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Min 4 chars" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Repeat password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn-register">
                <i class="fa-solid fa-user-check me-2"></i>Register &amp; Assign Role
            </button>
        </form>

        <div class="login-link">
            Already have an account? <a asp-action="Login">Sign in</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
