@model POSSystem.Models.User
@{ 
    ViewData["Title"] = "Add User"; 
}

<div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">
        <div class="card-theme">
            <div class="card-theme-header">
                <div>
                    <h5 class="card-theme-title">
                        <i class="fa-solid fa-user-plus" style="color:var(--accent-coral);"></i> Add Staff User
                    </h5>
                    <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">Create an account with an assigned system role</p>
                </div>
                <span class="pill-badge pill-coral">Staff</span>
            </div>

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Ramesh Cashier" autofocus />
                    <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Username <span class="text-danger">*</span></label>
                    <input asp-for="Username" class="form-control" placeholder="e.g. ramesh123" />
                    <span asp-validation-for="Username" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="RoleId" class="form-label">Assign Role <span class="text-danger">*</span></label>
                    <select asp-for="RoleId" asp-items="ViewBag.Roles" class="form-select" required>
                        <option value="">-- Choose Role --</option>
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-coral flex-grow-1 justify-content-center">
                        <i class="fa-solid fa-check"></i> Save User
                    </button>
                    <a asp-action="Index" class="btn-light-pill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
