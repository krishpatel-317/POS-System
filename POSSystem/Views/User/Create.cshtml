@model POSSystem.Models.StaffUserViewModel
@{ 
    ViewData["Title"] = "Add User"; 
}

<div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">
        <div class="card-theme">
            <div class="card-theme-header">
                <div>
                    <h5 class="card-theme-title">
                        <i class="fa-solid fa-user-plus" style="color:var(--accent-coral);"></i> Add Staff User
                    </h5>
                    <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">Create an account with an assigned system role</p>
                </div>
                <span class="pill-badge pill-coral">Identity</span>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:13px;"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Username <span class="text-danger">*</span></label>
                    <input asp-for="Username" class="form-control" placeholder="e.g. ramesh123" autofocus />
                    <span asp-validation-for="Username" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="e.g. ramesh@posstore.local" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" required />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Role" class="form-label">Assign Role <span class="text-danger">*</span></label>
                    <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select" required>
                    </select>
                    @if (ViewBag.AdminExists is bool adminExists && adminExists)
                    {
                        <div style="font-size:12px;color:var(--text-subtle);margin-top:6px;line-height:1.4;">
                            <i class="fa-solid fa-circle-info text-primary"></i> <strong>Single Store Owner Rule:</strong> This shop already has a registered Store Owner (Admin). All additional staff members are assigned as <strong>Cashier</strong>.
                        </div>
                    }
                    <span asp-validation-for="Role" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-coral flex-grow-1 justify-content-center">
                        <i class="fa-solid fa-check"></i> Save User
                    </button>
                    <a asp-action="Index" class="btn-light-pill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
