@model IEnumerable<POSSystem.Models.User>
@{ 
    ViewData["Title"] = "Staff & Users"; 
}

<div class="card-theme">
    <div class="card-theme-header">
        <div>
            <h5 class="card-theme-title">
                <i class="fa-solid fa-user-shield" style="color:var(--accent-coral);"></i> Staff &amp; System Users
            </h5>
            <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">
                Cashiers, managers, and administrators assigned to system access roles.
            </p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn-coral">
                <i class="fa-solid fa-plus"></i> Add User
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="width:54px;height:54px;background:var(--pill-gray);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:var(--text-subtle);">
                <i class="fa-solid fa-user-shield fa-lg"></i>
            </div>
            <div style="font-weight:700;font-size:14px;color:var(--text-title);">No users found</div>
            <p style="font-size:13px;color:var(--text-subtle);margin-top:2px;">Staff accounts will appear here.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Assigned Role</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="pill-badge pill-gray">@i</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;border-radius:50%;background:var(--accent-soft);color:var(--accent-coral);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;">
                                        @(item.Name.Length > 0 ? item.Name.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <span style="font-weight:700;color:var(--text-title);">@item.Name</span>
                                </div>
                            </td>
                            <td><span style="color:var(--text-subtle);font-size:13px;">@@@item.Username</span></td>
                            <td>
                                <span class="pill-badge pill-dark">
                                    <i class="fa-solid fa-shield-halved" style="color:var(--accent-coral);font-size:10px;"></i>
                                    @(item.Role?.Name ?? "No Role")
                                </span>
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.UserId" class="btn-light-pill me-1">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.UserId" class="btn-light-pill text-danger">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </a>
                                </td>
                            }
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>
