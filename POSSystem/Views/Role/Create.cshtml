@model POSSystem.Models.Role
@{
    ViewData["Title"] = "Add Role";
}

<div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">
        <div class="card-theme">
            <div class="card-theme-header">
                <div>
                    <h5 class="card-theme-title">
                        <i class="fa-solid fa-id-badge" style="color:var(--accent-coral);"></i> Add Role
                    </h5>
                    <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">
                        Select a role to define system access permissions.
                    </p>
                </div>
                <span class="pill-badge pill-coral">Security</span>
            </div>

            <form asp-action="Create" method="post">
                <div class="mb-4">
                    <label asp-for="Name" class="form-label">Access Role</label>
                    <select asp-for="Name" asp-items="ViewBag.EnumRoles" class="form-select" required>
                        <option value="">-- Select System Role --</option>
                    </select>
                    <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                    <small style="color:var(--text-subtle);font-size:12px;display:block;margin-top:8px;">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Defines the level of system access for staff assigned to this role.
                    </small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-coral flex-grow-1 justify-content-center">
                        <i class="fa-solid fa-check"></i> Save Role
                    </button>
                    <a asp-action="Index" class="btn-light-pill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
