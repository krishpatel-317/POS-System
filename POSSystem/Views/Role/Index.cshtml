@model IEnumerable<POSSystem.Models.Role>
@{
    ViewData["Title"] = "System Roles";
}

<div class="card-theme">
    <div class="card-theme-header">
        <div>
            <h5 class="card-theme-title">
                <i class="fa-solid fa-id-badge" style="color:var(--accent-coral);"></i> System Roles
            </h5>
            <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">
                Predefined security and permission levels for store staff.
            </p>
        </div>
        <a asp-action="Create" class="btn-coral">
            <i class="fa-solid fa-plus"></i> Add Role
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="width:54px;height:54px;background:var(--pill-gray);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:var(--text-subtle);">
                <i class="fa-solid fa-id-badge fa-lg"></i>
            </div>
            <div style="font-weight:700;font-size:14px;color:var(--text-title);">No roles found</div>
            <p style="font-size:13px;color:var(--text-subtle);margin-top:2px;">Add a system access role for staff management.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Role Name</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="pill-badge pill-gray">@i</span>
                            </td>
                            <td>
                                <span class="pill-badge pill-dark" style="font-size:13px;padding:6px 14px;">
                                    <i class="fa-solid fa-shield-halved" style="color:var(--accent-coral);font-size:11px;"></i>
                                    @item.Name
                                </span>
                            </td>
                            <td>
                                <span class="pill-badge pill-coral">System Standard</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.RoleId" class="btn-light-pill me-1">
                                    <i class="fa-solid fa-pen-to-square"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.RoleId" class="btn-light-pill text-danger">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>
