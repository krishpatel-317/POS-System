@model IEnumerable<POSSystem.Models.Customer>
@{ 
    ViewData["Title"] = "Customers"; 
}

<div class="card-theme">
    <div class="card-theme-header">
        <div>
            <h5 class="card-theme-title">
                <i class="fa-solid fa-users" style="color:var(--accent-coral);"></i> Customers
            </h5>
            <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">
                Directory of registered customers and contact information.
            </p>
        </div>
        <a asp-action="Create" class="btn-coral">
            <i class="fa-solid fa-plus"></i> Add Customer
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="width:54px;height:54px;background:var(--pill-gray);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:var(--text-subtle);">
                <i class="fa-solid fa-users fa-lg"></i>
            </div>
            <div style="font-weight:700;font-size:14px;color:var(--text-title);">No customers found</div>
            <p style="font-size:13px;color:var(--text-subtle);margin-top:2px;">Click "Add Customer" to register someone.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="pill-badge pill-gray">@i</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;border-radius:50%;background:var(--pill-gray);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;">
                                        @(item.Name.Length > 0 ? item.Name.Substring(0, 1).ToUpper() : "C")
                                    </div>
                                    <span style="font-weight:700;color:var(--text-title);">@item.Name</span>
                                </div>
                            </td>
                            <td><span style="color:var(--text-subtle);font-size:13px;">@item.Phone</span></td>
                            <td><span style="color:var(--text-subtle);font-size:13px;">@item.Email</span></td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn-light-pill me-1">
                                    <i class="fa-solid fa-pen-to-square"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn-light-pill text-danger">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>
