@model IEnumerable<POSSystem.Models.Customer>
@{ 
    ViewData["Title"] = "Customers Directory"; 
    string? search = ViewBag.Search as string;
    int totalCount = ViewBag.TotalCustomersCount ?? 0;
    int activeCount = ViewBag.ActiveBuyersCount ?? 0;
}

<!-- ═══ Metric Summary Badges ═══ -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-4">
        <div class="card-theme mb-0 p-3 d-flex align-items-center justify-content-between">
            <div>
                <div style="font-size:12px;font-weight:700;color:var(--text-subtle);text-transform:uppercase;letter-spacing:0.5px;">
                    Registered Customers
                </div>
                <div style="font-size:24px;font-weight:800;color:var(--text-title);margin-top:2px;">
                    @totalCount
                </div>
            </div>
            <div style="width:48px;height:48px;border-radius:50%;background:var(--accent-soft);color:var(--accent-coral);display:flex;align-items:center;justify-content:center;font-size:18px;">
                <i class="fa-solid fa-users"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card-theme mb-0 p-3 d-flex align-items-center justify-content-between">
            <div>
                <div style="font-size:12px;font-weight:700;color:var(--text-subtle);text-transform:uppercase;letter-spacing:0.5px;">
                    Active Repeat Buyers
                </div>
                <div style="font-size:24px;font-weight:800;color:var(--text-title);margin-top:2px;">
                    @activeCount <span style="font-size:13px;font-weight:500;color:var(--text-subtle);">with purchase history</span>
                </div>
            </div>
            <div style="width:48px;height:48px;border-radius:50%;background:#eafaf1;color:#1e824c;display:flex;align-items:center;justify-content:center;font-size:18px;">
                <i class="fa-solid fa-user-check"></i>
            </div>
        </div>
    </div>
</div>

<div class="card-theme">
    <div class="card-theme-header flex-wrap gap-3">
        <div>
            <h5 class="card-theme-title">
                <i class="fa-solid fa-address-book" style="color:var(--accent-coral);"></i> Customer Directory
            </h5>
            <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">
                Manage customer relationships, track order histories, and lifetime spend.
            </p>
        </div>
        <a asp-action="Create" class="btn-coral">
            <i class="fa-solid fa-plus"></i> Add Customer
        </a>
    </div>

    <!-- Search Bar -->
    <form method="get" asp-action="Index" class="mb-4">
        <div class="row g-2">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border-radius:var(--radius-pill) 0 0 var(--radius-pill);border-color:var(--border-soft);">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" name="search" value="@search" class="form-control border-start-0" 
                           placeholder="Search customer by name, phone, or email..." 
                           style="border-color:var(--border-soft);box-shadow:none;" />
                    <button type="submit" class="btn-coral" style="border-radius:0 var(--radius-pill) var(--radius-pill) 0;padding:0 20px;">
                        Search
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <div class="col-auto d-flex align-items-center">
                    <a asp-action="Index" class="btn-light-pill">
                        <i class="fa-solid fa-xmark"></i> Clear Filter
                    </a>
                </div>
            }
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="width:54px;height:54px;background:var(--pill-gray);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:var(--text-subtle);">
                <i class="fa-solid fa-users fa-lg"></i>
            </div>
            <div style="font-weight:700;font-size:15px;color:var(--text-title);">No customers found</div>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <p style="font-size:13px;color:var(--text-subtle);margin-top:2px;">
                    No results matched "<strong>@search</strong>". Try searching with another keyword.
                </p>
                <a asp-action="Index" class="btn-light-pill mt-2">View All Customers</a>
            }
            else
            {
                <p style="font-size:13px;color:var(--text-subtle);margin-top:2px;">Click "Add Customer" to register your first customer.</p>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th class="text-center">Total Orders</th>
                        <th>Lifetime Spend</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var item in Model)
                    {
                        var nonVoidedSales = item.Sales?.Where(s => s.Status != "Voided").ToList() ?? new List<POSSystem.Models.Sale>();
                        int orderCount = nonVoidedSales.Count;
                        decimal totalSpend = nonVoidedSales.Sum(s => s.TotalAmount);

                        <tr>
                            <td><span class="pill-badge pill-gray">@i</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:36px;height:36px;border-radius:50%;background:var(--accent-soft);color:var(--accent-coral);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;">
                                        @(item.Name.Length > 0 ? item.Name.Substring(0, 1).ToUpper() : "C")
                                    </div>
                                    <div>
                                        <div style="font-weight:700;color:var(--text-title);">
                                            <a asp-action="Details" asp-route-id="@item.CustomerId" style="color:var(--text-title);text-decoration:none;">
                                                @item.Name
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span style="color:var(--text-body);font-size:13px;font-weight:600;">
                                    <i class="fa-solid fa-phone text-muted me-1" style="font-size:11px;"></i>@item.Phone
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Email))
                                {
                                    <span style="color:var(--text-subtle);font-size:13px;">
                                        <i class="fa-regular fa-envelope text-muted me-1" style="font-size:11px;"></i>@item.Email
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--text-subtle);font-size:13px;">&mdash;</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (orderCount > 0)
                                {
                                    <span class="pill-badge pill-green">
                                        <i class="fa-solid fa-bag-shopping me-1"></i>@orderCount @(orderCount == 1 ? "order" : "orders")
                                    </span>
                                }
                                else
                                {
                                    <span class="pill-badge pill-gray text-muted">0 orders</span>
                                }
                            </td>
                            <td>
                                <span style="font-weight:800;color:var(--text-title);font-size:13px;">
                                    &#8377;@totalSpend.ToString("N2")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn-light-pill me-1" title="View Customer Profile & Purchase History">
                                    <i class="fa-solid fa-clock-rotate-left"></i> History
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn-light-pill me-1" title="Edit Customer">
                                    <i class="fa-solid fa-pen-to-square"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn-light-pill text-danger" title="Delete Customer">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>
