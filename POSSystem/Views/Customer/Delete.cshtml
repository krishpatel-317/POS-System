@model POSSystem.Models.Customer
@{ 
    ViewData["Title"] = "Delete Customer"; 
}

<div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">
        <div class="card-theme">
            <div class="text-center mb-4">
                <div style="width:58px;height:58px;background:var(--accent-soft);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;color:var(--accent-coral);">
                    <i class="fa-solid fa-trash fa-lg"></i>
                </div>
                <h5 style="font-weight:800;color:var(--text-title);margin:0;">Delete Customer?</h5>
                <p style="font-size:13px;color:var(--text-subtle);margin-top:4px;">
                    Are you sure you want to remove <strong>"@Model.Name"</strong>?
                </p>
            </div>

            <div class="p-3 rounded-4 mb-4" style="background:#faf9f6;border:1px solid var(--border-soft);">
                <div class="d-flex justify-content-between mb-2">
                    <span style="font-size:13px;color:var(--text-subtle);">Phone</span>
                    <span style="font-weight:700;">@Model.Phone</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span style="font-size:13px;color:var(--text-subtle);">Email</span>
                    <span style="font-weight:700;">@Model.Email</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span style="font-size:13px;color:var(--text-subtle);">Historical Orders</span>
                    <span class="pill-badge pill-gray">@(Model.Sales?.Count ?? 0) sales</span>
                </div>
            </div>

            @if ((Model.Sales?.Count ?? 0) > 0)
            {
                <div class="p-3 rounded-4 mb-4" style="background:#eff6ff;border:1px solid #bfdbfe;font-size:12px;color:#1e40af;">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    <strong>Smart Unlink:</strong> Deleting this customer will remove their profile while safely preserving their past receipts under <em>"Walk-in Customer"</em>.
                </div>
            }

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="CustomerId" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn-coral flex-grow-1 justify-content-center">
                        <i class="fa-solid fa-trash"></i> Yes, Delete
                    </button>
                    <a asp-action="Index" class="btn-light-pill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
