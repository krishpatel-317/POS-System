@{
    ViewData["Title"] = "Dashboard";
}

<!-- ═══ Top Hero Section (Inspired by Reference Screenshot) ═══ -->
<div class="row align-items-center mb-4 g-4">
    <!-- Date & Quick Action Pill -->
    <div class="col-lg-5 col-md-6">
        <div class="card-theme p-3 mb-0 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div style="width:52px;height:52px;border-radius:50%;border:2px solid var(--border-soft);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:var(--text-title);">
                    @DateTime.Now.ToString("dd")
                </div>
                <div>
                    <div style="font-weight:700;font-size:14px;color:var(--text-title);line-height:1.2;">
                        @DateTime.Now.ToString("ddd,")
                    </div>
                    <div style="font-weight:500;font-size:12px;color:var(--text-subtle);">
                        @DateTime.Now.ToString("MMMM yyyy")
                    </div>
                </div>
            </div>

            <a asp-controller="Sale" asp-action="Create" class="btn-coral" style="padding:10px 20px;font-size:13px;">
                Record Sale <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <!-- Big Welcome Greeting -->
    <div class="col-lg-7 col-md-6">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h2 style="font-weight:800;letter-spacing:-0.5px;color:var(--text-title);margin:0;font-size:26px;">
                    Hey, Welcome back! <span style="font-size:24px;">👋</span>
                </h2>
                <p style="font-size:15px;color:var(--text-subtle);margin:4px 0 0;font-weight:500;">
                    Manage your store, inventory &amp; sales smoothly.
                </p>
            </div>
            <div style="width:48px;height:48px;border-radius:50%;background:#ffffff;border:1px solid var(--border-soft);display:flex;align-items:center;justify-content:center;color:var(--text-title);font-size:16px;">
                <i class="fa-solid fa-bell"></i>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Stat Overview Cards (Financial & Retail Vibe) ═══ -->
<div class="row g-4 mb-4">
    <!-- Today's Revenue -->
    <div class="col-xl-3 col-sm-6">
        <div class="card-theme mb-0 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="pill-badge pill-coral">
                    <i class="fa-solid fa-bolt"></i> Today
                </span>
                <span class="pill-badge pill-gray">Revenue</span>
            </div>
            <div>
                <div style="font-size:12px;font-weight:600;color:var(--text-subtle);margin-bottom:4px;">Total Earnings</div>
                <div style="font-size:28px;font-weight:800;color:var(--accent-coral);letter-spacing:-0.5px;">
                    &#8377;@String.Format("{0:N2}", ViewBag.TodayRevenue)
                </div>
            </div>
            <div class="mt-3 pt-3 border-top" style="border-color:var(--border-soft) !important;">
                <a asp-controller="Sale" asp-action="Index" style="font-size:12px;font-weight:700;color:var(--text-title);text-decoration:none;">
                    View sales history <i class="fa-solid fa-arrow-right ms-1 text-muted" style="font-size:10px;"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Total Products -->
    <div class="col-xl-3 col-sm-6">
        <div class="card-theme mb-0 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="pill-badge pill-dark">Inventory</span>
                <span class="pill-badge pill-gray">Active</span>
            </div>
            <div>
                <div style="font-size:12px;font-weight:600;color:var(--text-subtle);margin-bottom:4px;">Total Products</div>
                <div style="font-size:28px;font-weight:800;color:var(--text-title);letter-spacing:-0.5px;">
                    @ViewBag.TotalProducts
                </div>
            </div>
            <div class="mt-3 pt-3 border-top" style="border-color:var(--border-soft) !important;">
                <a asp-controller="Product" asp-action="Index" style="font-size:12px;font-weight:700;color:var(--text-title);text-decoration:none;">
                    Manage catalog <i class="fa-solid fa-arrow-right ms-1 text-muted" style="font-size:10px;"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Total Categories -->
    <div class="col-xl-3 col-sm-6">
        <div class="card-theme mb-0 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="pill-badge pill-gray">
                    <i class="fa-solid fa-tags"></i> Groups
                </span>
                <span class="pill-badge pill-gray">Sections</span>
            </div>
            <div>
                <div style="font-size:12px;font-weight:600;color:var(--text-subtle);margin-bottom:4px;">Categories</div>
                <div style="font-size:28px;font-weight:800;color:var(--text-title);letter-spacing:-0.5px;">
                    @ViewBag.TotalCategories
                </div>
            </div>
            <div class="mt-3 pt-3 border-top" style="border-color:var(--border-soft) !important;">
                <a asp-controller="Category" asp-action="Index" style="font-size:12px;font-weight:700;color:var(--text-title);text-decoration:none;">
                    View categories <i class="fa-solid fa-arrow-right ms-1 text-muted" style="font-size:10px;"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Total Customers -->
    <div class="col-xl-3 col-sm-6">
        <div class="card-theme mb-0 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="pill-badge pill-green">
                    <i class="fa-solid fa-user-check"></i> Customers
                </span>
                <span class="pill-badge pill-gray">Registered</span>
            </div>
            <div>
                <div style="font-size:12px;font-weight:600;color:var(--text-subtle);margin-bottom:4px;">Total Customers</div>
                <div style="font-size:28px;font-weight:800;color:var(--text-title);letter-spacing:-0.5px;">
                    @ViewBag.TotalCustomers
                </div>
            </div>
            <div class="mt-3 pt-3 border-top" style="border-color:var(--border-soft) !important;">
                <a asp-controller="Customer" asp-action="Index" style="font-size:12px;font-weight:700;color:var(--text-title);text-decoration:none;">
                    Customer directory <i class="fa-solid fa-arrow-right ms-1 text-muted" style="font-size:10px;"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Main Data Tables (Recent Sales & Stock Alerts) ═══ -->
<div class="row g-4">
    <!-- Recent Sales Card -->
    <div class="col-lg-8">
        <div class="card-theme mb-0">
            <div class="card-theme-header">
                <div>
                    <h5 class="card-theme-title">
                        <i class="fa-solid fa-receipt" style="color:var(--accent-coral);"></i> Recent Sales
                    </h5>
                    <p style="font-size:12px;color:var(--text-subtle);margin:2px 0 0;">Latest customer transactions</p>
                </div>
                <a asp-controller="Sale" asp-action="Index" class="btn-light-pill">
                    All Sales <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>

            @{
                var recentSales = ViewBag.RecentSales as IEnumerable<POSSystem.Models.Sale> ?? Enumerable.Empty<POSSystem.Models.Sale>();
            }

            @if (!recentSales.Any())
            {
                <div class="text-center py-5">
                    <div style="width:54px;height:54px;background:var(--pill-gray);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:var(--text-subtle);">
                        <i class="fa-solid fa-receipt fa-lg"></i>
                    </div>
                    <div style="font-weight:700;font-size:14px;color:var(--text-title);">No sales recorded yet</div>
                    <p style="font-size:13px;color:var(--text-subtle);margin-top:2px;">Click "Record Sale" above to log your first sale.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Sale #</th>
                                <th>Customer</th>
                                <th>Cashier</th>
                                <th>Date &amp; Time</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in recentSales)
                            {
                                <tr>
                                    <td>
                                        <span class="pill-badge pill-gray">#@s.SaleId</span>
                                    </td>
                                    <td>@(s.Customer?.Name ?? "Walk-in Customer")</td>
                                    <td><span style="color:var(--text-subtle);font-size:13px;">@(s.User?.Name ?? "Staff")</span></td>
                                    <td><span style="color:var(--text-subtle);font-size:13px;">@s.SaleDate.ToString("dd MMM, hh:mm tt")</span></td>
                                    <td class="text-end">
                                        <span style="font-weight:800;color:var(--accent-coral);">&#8377;@s.TotalAmount.ToString("N2")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Low Stock Alert Card -->
    <div class="col-lg-4">
        <div class="card-theme mb-0">
            <div class="card-theme-header">
                <div>
                    <h5 class="card-theme-title">
                        <i class="fa-solid fa-triangle-exclamation" style="color:var(--accent-coral);"></i> Stock Alert
                    </h5>
                    <p style="font-size:12px;color:var(--text-subtle);margin:2px 0 0;">Low quantity products (≤ 5)</p>
                </div>
                <a asp-controller="Product" asp-action="Index" class="btn-light-pill">
                    View
                </a>
            </div>

            @{
                var lowStock = ViewBag.LowStockProducts as IEnumerable<POSSystem.Models.Product> ?? Enumerable.Empty<POSSystem.Models.Product>();
            }

            @if (!lowStock.Any())
            {
                <div class="text-center py-5">
                    <div style="width:54px;height:54px;background:#eafaf1;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;color:#1e824c;">
                        <i class="fa-solid fa-circle-check fa-lg"></i>
                    </div>
                    <div style="font-weight:700;font-size:14px;color:var(--text-title);">All Products Well Stocked</div>
                    <p style="font-size:12px;color:var(--text-subtle);margin-top:2px;">Inventory quantities are healthy.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var p in lowStock)
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 rounded-4" style="background:#faf9f6;border:1px solid var(--border-soft);">
                            <div>
                                <div style="font-weight:700;font-size:14px;color:var(--text-title);">@p.Name</div>
                                <span class="pill-badge pill-gray" style="font-size:11px;">@(p.Category?.Name ?? "General")</span>
                            </div>
                            <div>
                                @if (p.StockQuantity == 0)
                                {
                                    <span class="pill-badge pill-coral">Out of Stock</span>
                                }
                                else
                                {
                                    <span class="pill-badge pill-yellow">@p.StockQuantity left</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
