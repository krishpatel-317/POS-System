@{
    ViewData["Title"] = "Dashboard";
}

<!-- ═══ Top Hero Section ═══ -->
<div class="row align-items-center mb-4 g-4">
    <!-- Date & Quick Action Pill -->
    <div class="col-lg-5 col-md-6">
        <div class="card-theme p-3 mb-0 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div style="width:52px;height:52px;border-radius:50%;border:2px solid var(--border-soft);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:var(--text-title);background:#ffffff;">
                    @DateTime.Now.ToString("dd")
                </div>
                <div>
                    <div style="font-weight:700;font-size:14px;color:var(--text-title);line-height:1.2;">
                        @DateTime.Now.ToString("dddd")
                    </div>
                    <div style="font-weight:500;font-size:12px;color:var(--text-subtle);">
                        @DateTime.Now.ToString("MMMM yyyy")
                    </div>
                </div>
            </div>

            @if (!User.IsInRole("Admin"))
            {
                <a asp-controller="Sale" asp-action="Create" class="btn-coral" style="padding:10px 20px;font-size:13px;">
                    <i class="fa-solid fa-cart-plus"></i> New Sale
                </a>
            }
        </div>
    </div>

    <!-- Personalized Welcome Greeting -->
    <div class="col-lg-7 col-md-6">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h2 style="font-weight:800;letter-spacing:-0.5px;color:var(--text-title);margin:0;font-size:24px;">
                    Hey @(User.Identity?.Name ?? "Cashier"), Welcome back! <span style="font-size:22px;">👋</span>
                </h2>
                <p style="font-size:14px;color:var(--text-subtle);margin:4px 0 0;font-weight:500;">
                    Live retail store summary and cashier activity.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Sale" asp-action="Index" class="btn-light-pill" style="font-size:12px;">
                    <i class="fa-solid fa-list-check"></i> Sales History
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Key Performance Stat Overview Cards ═══ -->
<div class="row g-4 mb-4">
    <!-- Today's Revenue -->
    <div class="col-xl-3 col-sm-6">
        <div class="card-theme mb-0 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="pill-badge pill-coral">
                    <i class="fa-solid fa-bolt"></i> Today
                </span>
                <span class="pill-badge pill-gray">Revenue</span>
            </div>
            <div>
                <div style="font-size:12px;font-weight:600;color:var(--text-subtle);margin-bottom:4px;">Today's Earnings</div>
                <div style="font-size:28px;font-weight:800;letter-spacing:-0.5px;color:var(--accent-coral);">
                    &#8377;@(((decimal)(ViewBag.TodayRevenue ?? 0)).ToString("N2"))
                </div>
                <div style="font-size:12px;color:var(--text-subtle);margin-top:4px;">
                    <i class="fa-solid fa-check-double text-success"></i> @(ViewBag.TodaySalesCount ?? 0) transaction(s) today
                </div>
            </div>
            <a asp-controller="Sale" asp-action="Index" asp-route-dateRange="today" class="d-flex align-items-center gap-2 pt-3 mt-3 border-top text-decoration-none" style="border-color:var(--border-soft) !important;font-size:13px;font-weight:700;color:var(--text-title);">
                View today's sales <i class="fa-solid fa-arrow-right" style="font-size:11px;"></i>
            </a>
        </div>
    </div>

    <!-- Total Products -->
    <div class="col-xl-3 col-sm-6">
        <div class="card-theme mb-0 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="pill-badge pill-dark">
                    <i class="fa-solid fa-boxes-stacked"></i> Inventory
                </span>
                <span class="pill-badge pill-gray">Active</span>
            </div>
            <div>
                <div style="font-size:12px;font-weight:600;color:var(--text-subtle);margin-bottom:4px;">Total Products</div>
                <div style="font-size:28px;font-weight:800;letter-spacing:-0.5px;color:var(--text-title);">
                    @ViewBag.TotalProducts
                </div>
                <div style="font-size:12px;color:var(--text-subtle);margin-top:4px;">
                    In @ViewBag.TotalCategories category groups
                </div>
            </div>
            <a asp-controller="Product" asp-action="Index" class="d-flex align-items-center gap-2 pt-3 mt-3 border-top text-decoration-none" style="border-color:var(--border-soft) !important;font-size:13px;font-weight:700;color:var(--text-title);">
                Manage catalog <i class="fa-solid fa-arrow-right" style="font-size:11px;"></i>
            </a>
        </div>
    </div>

    <!-- Store Lifetime Volume -->
    <div class="col-xl-3 col-sm-6">
        <div class="card-theme mb-0 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="pill-badge pill-green">
                    <i class="fa-solid fa-vault"></i> Store Volume
                </span>
                <span class="pill-badge pill-gray">All-Time</span>
            </div>
            <div>
                <div style="font-size:12px;font-weight:600;color:var(--text-subtle);margin-bottom:4px;">Lifetime Revenue</div>
                <div style="font-size:28px;font-weight:800;letter-spacing:-0.5px;color:var(--text-title);">
                    &#8377;@(((decimal)(ViewBag.AllTimeRevenue ?? 0)).ToString("N2"))
                </div>
                <div style="font-size:12px;color:var(--text-subtle);margin-top:4px;">
                    Across @ViewBag.TotalSales total sales
                </div>
            </div>
            <a asp-controller="Sale" asp-action="Index" class="d-flex align-items-center gap-2 pt-3 mt-3 border-top text-decoration-none" style="border-color:var(--border-soft) !important;font-size:13px;font-weight:700;color:var(--text-title);">
                Full audit history <i class="fa-solid fa-arrow-right" style="font-size:11px;"></i>
            </a>
        </div>
    </div>

    <!-- Customers Registered -->
    <div class="col-xl-3 col-sm-6">
        <div class="card-theme mb-0 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="pill-badge pill-gray">
                    <i class="fa-solid fa-user-group"></i> Customers
                </span>
                <span class="pill-badge pill-gray">Registered</span>
            </div>
            <div>
                <div style="font-size:12px;font-weight:600;color:var(--text-subtle);margin-bottom:4px;">Total Customers</div>
                <div style="font-size:28px;font-weight:800;letter-spacing:-0.5px;color:var(--text-title);">
                    @ViewBag.TotalCustomers
                </div>
                <div style="font-size:12px;color:var(--text-subtle);margin-top:4px;">
                    Avg Ticket: &#8377;@(((decimal)(ViewBag.AverageOrderValue ?? 0)).ToString("N2"))
                </div>
            </div>
            <a asp-controller="Customer" asp-action="Index" class="d-flex align-items-center gap-2 pt-3 mt-3 border-top text-decoration-none" style="border-color:var(--border-soft) !important;font-size:13px;font-weight:700;color:var(--text-title);">
                Customer directory <i class="fa-solid fa-arrow-right" style="font-size:11px;"></i>
            </a>
        </div>
    </div>
</div>

<!-- ═══ Main Data Row: Recent Transactions & Low Stock Alerts ═══ -->
<div class="row g-4">
    <!-- Recent Transactions Table -->
    <div class="col-xl-8">
        <div class="card-theme h-100 mb-0">
            <div class="card-theme-header">
                <div>
                    <h5 class="card-theme-title">
                        <i class="fa-solid fa-receipt" style="color:var(--accent-coral);"></i> Recent Sales
                    </h5>
                    <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">Latest customer transactions across all store counters</p>
                </div>
                <a asp-controller="Sale" asp-action="Index" class="btn-light-pill" style="font-size:12px;">
                    All Sales <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>

            @if (ViewBag.RecentSales == null || ((List<POSSystem.Models.Sale>)ViewBag.RecentSales).Count == 0)
            {
                <div class="text-center py-5">
                    <div style="width:48px;height:48px;background:var(--pill-gray);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;color:var(--text-subtle);">
                        <i class="fa-solid fa-cart-shopping"></i>
                    </div>
                    <div style="font-weight:700;font-size:14px;color:var(--text-title);">No transactions recorded yet</div>
                    <p style="font-size:12px;color:var(--text-subtle);margin-top:2px;">Click "New Sale" to process your first order.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Sale #</th>
                                <th>Customer</th>
                                <th>Cashier</th>
                                <th>Date &amp; Time</th>
                                <th>Amount</th>
                                <th class="text-end">Receipt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sale in (List<POSSystem.Models.Sale>)ViewBag.RecentSales)
                            {
                                <tr>
                                    <td>
                                        <span class="pill-badge pill-gray">#@sale.SaleId</span>
                                    </td>
                                    <td>
                                        <span style="font-weight:700;">@(sale.Customer?.Name ?? "Walk-in Customer")</span>
                                    </td>
                                    <td>
                                        <span class="pill-badge pill-gray">
                                            <i class="fa-solid fa-user-tag text-muted"></i>
                                            @(sale.User?.UserName ?? "Staff")
                                        </span>
                                    </td>
                                    <td>
                                        <span style="color:var(--text-subtle);font-size:12px;">@sale.SaleDate.ToString("dd MMM, hh:mm tt")</span>
                                    </td>
                                    <td>
                                        <span style="font-weight:800;color:var(--accent-coral);">&#8377;@sale.TotalAmount.ToString("N2")</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Sale" asp-action="Details" asp-route-id="@sale.SaleId" class="btn-light-pill" style="padding:6px 12px;font-size:12px;">
                                            <i class="fa-solid fa-print"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Stock Alerts & Quick Insights -->
    <div class="col-xl-4">
        <div class="card-theme h-100 mb-0 d-flex flex-column justify-content-between">
            <div>
                <div class="card-theme-header">
                    <div>
                        <h5 class="card-theme-title">
                            <i class="fa-solid fa-triangle-exclamation text-warning"></i> Stock Alert
                        </h5>
                        <p style="font-size:13px;color:var(--text-subtle);margin:2px 0 0;">Low quantity products (&le; 5 units)</p>
                    </div>
                    <a asp-controller="Product" asp-action="Index" class="btn-light-pill" style="font-size:12px;">View</a>
                </div>

                @if (ViewBag.LowStockProducts == null || ((List<POSSystem.Models.Product>)ViewBag.LowStockProducts).Count == 0)
                {
                    <div class="text-center py-4">
                        <div style="width:44px;height:44px;background:#eafaf1;color:#1e824c;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;font-size:16px;">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <div style="font-weight:700;font-size:14px;color:var(--text-title);">All Products Well Stocked</div>
                        <p style="font-size:12px;color:var(--text-subtle);margin-top:2px;">Inventory quantities are healthy.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var prod in (List<POSSystem.Models.Product>)ViewBag.LowStockProducts)
                        {
                            <div class="p-3 rounded-4 d-flex align-items-center justify-content-between" style="background:#faf9f6;border:1px solid var(--border-soft);">
                                <div>
                                    <div style="font-weight:700;font-size:14px;color:var(--text-title);">@prod.Name</div>
                                    <small style="color:var(--text-subtle);font-size:12px;">@(prod.Category?.Name ?? "General")</small>
                                </div>
                                <div class="text-end d-flex align-items-center gap-2">
                                    <span class="pill-badge @(prod.StockQuantity == 0 ? "pill-coral" : "pill-yellow")">
                                        @prod.StockQuantity left
                                    </span>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form asp-controller="Product" asp-action="Restock" method="post" style="margin:0;">
                                            <input type="hidden" name="id" value="@prod.ProductId" />
                                            <input type="hidden" name="additionalStock" value="10" />
                                            <input type="hidden" name="returnUrl" value="/Home/Index" />
                                            <button type="submit" class="btn btn-sm btn-light-pill px-2 py-1" style="font-size:11px;" title="Instantly restock +10 units">
                                                <i class="fa-solid fa-plus text-success"></i> 10
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            </div>
        </div>
    </div>
</div>
